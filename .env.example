# Plantilla de variables de entorno de Palenque (sección 4 de la especificación).
# Copiala a .env.local y completá los valores ahí. Este archivo va SIN valores.

APP_ENV=development
NEXT_PUBLIC_APP_URL=

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# WhatsApp Cloud API (Fase 5)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=

# IA y transcripción (Fase 6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# Trabajos programados y avisos (Fase 7)
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RESEND_API_KEY=

# Solo en .env.test.local: ref del proyecto palenque-test
TEST_SUPABASE_PROJECT_REF=
